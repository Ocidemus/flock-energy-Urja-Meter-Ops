{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter Ops API",
    "description": "Clean, reliable, normalized REST API providing programmatic access to utility smart meters, distribution transformers, network hierarchy, and interval energy telemetry from the legacy Urja Meter Ops portal.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service & upstream health status",
        "description": "Reports health status of the API service, cache warmth, and upstream session state.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "List and search smart meters",
        "description": "Returns a paginated list of meters supporting cross-attribute filtering and text search.",
        "operationId": "list_meters_api_v1_meters_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search term matching meter ID or serial number",
              "title": "Q"
            },
            "description": "Search term matching meter ID or serial number"
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by hardware manufacturer (e.g. Genus, HPL, L&T, Secure, Allied)",
              "title": "Make"
            },
            "description": "Filter by hardware manufacturer (e.g. Genus, HPL, L&T, Secure, Allied)"
          },
          {
            "name": "phase",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by phase configuration ('single' or 'three')",
              "title": "Phase"
            },
            "description": "Filter by phase configuration ('single' or 'three')"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by operational status ('Installed', 'Faulty', 'Decommissioned')",
              "title": "Status"
            },
            "description": "Filter by operational status ('Installed', 'Faulty', 'Decommissioned')"
          },
          {
            "name": "dt_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by distribution transformer code (e.g. DT-001)",
              "title": "Dt Code"
            },
            "description": "Filter by distribution transformer code (e.g. DT-001)"
          },
          {
            "name": "install_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by installation type ('Whole Current', 'CT Operated')",
              "title": "Install Type"
            },
            "description": "Filter by installation type ('Whole Current', 'CT Operated')"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1-based)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-based)"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Items per page (max 100)",
              "default": 20,
              "title": "Page Size"
            },
            "description": "Items per page (max 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meter_id}": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get meter profile and details",
        "description": "Retrieves full profile for a meter including nameplate specs, coordinates, and network hierarchy.",
        "operationId": "get_meter_api_v1_meters__meter_id__get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meter_id}/consumption": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get interval energy consumption",
        "description": "Fetches normalized 30-minute interval readings (kWh, kVAh, Voltage) for a given meter.",
        "operationId": "get_consumption_api_v1_meters__meter_id__consumption_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          },
          {
            "name": "from_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start date (YYYY-MM-DD)",
              "title": "From Date"
            },
            "description": "Start date (YYYY-MM-DD)"
          },
          {
            "name": "to_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "End date (YYYY-MM-DD)",
              "title": "To Date"
            },
            "description": "End date (YYYY-MM-DD)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/sync": {
      "post": {
        "tags": [
          "Meters"
        ],
        "summary": "Trigger manual cache synchronization",
        "description": "Forces an immediate synchronization with the upstream portal.",
        "operationId": "sync_cache_api_v1_meters_sync_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/transformers": {
      "get": {
        "tags": [
          "Transformers"
        ],
        "summary": "List distribution transformers",
        "description": "Returns all 40 distribution transformers in the network with their feeding lines and capacities.",
        "operationId": "list_transformers_api_v1_transformers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransformerListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transformers/{code}": {
      "get": {
        "tags": [
          "Transformers"
        ],
        "summary": "Get transformer details and connected meters",
        "description": "Retrieves detailed information for a transformer including all meters connected to it.",
        "operationId": "get_transformer_api_v1_transformers__code__get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransformerDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/network/hierarchy": {
      "get": {
        "tags": [
          "Network & Bulk Data"
        ],
        "summary": "Get full 7-level distribution network hierarchy",
        "description": "Reconstructs and returns the full utility grid tree: Zone -> Circle -> Division -> Subdivision -> Substation -> Feeder -> DT.",
        "operationId": "get_network_hierarchy_api_v1_network_hierarchy_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/NetworkTreeNode"
                  },
                  "type": "array",
                  "title": "Response Get Network Hierarchy Api V1 Network Hierarchy Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/export/meters": {
      "get": {
        "tags": [
          "Network & Bulk Data"
        ],
        "summary": "Direct bulk export of all meters with full attributes",
        "description": "Retrieves all 403 meters in a single operation via authenticated HMAC bulk export.",
        "operationId": "export_all_meters_api_v1_export_meters_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MeterDetail"
                  },
                  "type": "array",
                  "title": "Response Export All Meters Api V1 Export Meters Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
